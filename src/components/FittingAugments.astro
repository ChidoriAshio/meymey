---
import { FIT_PER_RARITY, FIT_SHOWN, RARITY_LABEL, championPickShare, championPlays, cnStats, formatRate, hasPickShares, type Augment, type Champion, type Rarity } from '../lib/data';

interface Props {
  champion: Champion;
  // Best first, up to FIT_PER_RARITY of each rarity.
  fitting: Augment[];
  // Curated picks (builds.yaml), marked in the list and always shown.
  featured?: Set<string>;
}

const { champion, fitting, featured = new Set() } = Astro.props;
const plays = championPlays(champion);
const shares = hasPickShares(champion);
const rarities: Rarity[] = ['silver', 'gold', 'prismatic'];
const text = { silver: 'text-silver', gold: 'text-gold', prismatic: 'text-prismatic' };
const ring = { silver: 'ring-silver', gold: 'ring-gold', prismatic: 'ring-prismatic' };
---

<section class="mb-8" data-fit data-shown={FIT_SHOWN}>
  <h2 class="text-lg font-bold">相性の良いオーグメント</h2>
  <p class="text-xs text-ink-2 mt-1 mb-3">
    {
      shares
        ? `${champion.name}の試合で実際に選ばれた割合（中国サーバー約${Math.round(cnStats.matches / 10000)}万試合の集計${plays > 0 ? `＋集めた試合${plays}件` : ''}）を中心に、タイプ・効果文からの相性も加えた目安です。数字は${champion.name}の試合で選ばれた割合です。`
        : 'チャンピオンのタイプとオーグメントの効果文から自動で選んだ目安です。数字は全体のピック率です。'
    }
    （全レアリティでは上位{FIT_SHOWN}個、レアリティごとでは最大{FIT_PER_RARITY}個。上ほどおすすめ）
    {featured.size > 0 && <><br /><span class="featured-mark">★ 特におすすめ</span> は、このチャンピオンと特に相性が良いとされる組み合わせ（arammayhem.com のコンボ）です。</>}
  </p>
  <div class="flex flex-wrap gap-2 mb-3">
    <label class="fit-check">
      <input type="checkbox" data-fit-all checked />
      全レアリティ
    </label>
    {
      rarities.map((r) => (
        <label class={`fit-check ${text[r]}`}>
          <input type="checkbox" data-fit-rarity={r} checked />
          {RARITY_LABEL[r]}
        </label>
      ))
    }
  </div>
  <ol class="flex flex-col gap-1.5" data-fit-list>
    {
      fitting.map((a, i) => (
        <li
          data-rarity={a.rarity}
          data-featured={featured.has(a.slug) ? '' : undefined}
          hidden={i >= FIT_SHOWN && !featured.has(a.slug)}
          class="aug-tip relative"
          tabindex="0"
        >
          <div class:list={['flex items-center gap-2 rounded-md border border-line bg-panel px-2 py-1.5 cursor-help', featured.has(a.slug) && 'is-featured']}>
            <span class="w-5 text-right text-[11px] text-ink-2 tabular-nums shrink-0" data-fit-rank />
            {a.icon && (
              <img src={a.icon} alt="" width="28" height="28" loading="lazy" class={`size-7 rounded ring-1 ${ring[a.rarity]} bg-panel-2 shrink-0`} />
            )}
            <span class="text-sm leading-tight flex-1 min-w-0">
              {a.name}
              {featured.has(a.slug) && <span class="featured-mark ml-1 whitespace-nowrap">★ 特におすすめ</span>}
            </span>
            <span class="text-[11px] text-ink-2 tabular-nums shrink-0">
              {formatRate(shares ? championPickShare(champion, a)! * 100 || null : a.pickRate)}
            </span>
          </div>
          <div role="tooltip" class="aug-tip-body absolute left-0 right-0 top-full z-20 -mt-px rounded-lg border border-line bg-panel-2 p-3 shadow-lg">
            <div class="font-semibold leading-tight">
              {a.name}
              <span class={`text-xs font-normal ml-1 ${text[a.rarity]}`}>{RARITY_LABEL[a.rarity]}</span>
            </div>
            <p class="tooltip-text text-xs text-ink-2 mt-1 leading-relaxed" set:html={a.description} />
            <a href={`/augments/${a.slug}/`} class="inline-block text-xs text-accent mt-2 hover:underline">
              詳しく見る →
            </a>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .fit-check {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .fit-check:has(input:checked) {
    border-color: var(--color-accent);
    background: rgb(200 170 110 / 0.08);
  }
  .aug-tip-body {
    display: none;
  }
  /* Hover on PC, tap (focus) on phones. Hovering the tooltip itself keeps it open for the link. */
  .aug-tip:focus-within {
    z-index: 10;
  }
  .aug-tip:focus-within .aug-tip-body {
    display: block;
  }
  .aug-tip:focus-within > div:first-child {
    border-color: var(--color-accent);
  }
  /* Phones keep :hover after a tap, which would stop the tooltip from closing. */
  @media (hover: hover) {
    .aug-tip:hover {
      z-index: 10;
    }
    .aug-tip:hover .aug-tip-body {
      display: block;
    }
    .aug-tip:hover > div:first-child {
      border-color: var(--color-accent);
    }
  }
  .featured-mark {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-gold);
  }
  .is-featured {
    border-color: rgb(229 185 78 / 0.7);
    background: linear-gradient(90deg, rgb(229 185 78 / 0.14), transparent 70%), var(--color-panel);
  }
  .fit-check input {
    accent-color: var(--color-accent);
  }
</style>

<script>
  // Checkboxes pick which rarities show; "全レアリティ" turns all on (or all off) at once.
  for (const root of document.querySelectorAll<HTMLElement>('[data-fit]')) {
    const all = root.querySelector<HTMLInputElement>('[data-fit-all]')!;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-fit-rarity]')];
    const rows = [...root.querySelectorAll<HTMLElement>('li[data-rarity]')];
    const list = root.querySelector<HTMLElement>('[data-fit-list]')!;
    const limit = Number(root.dataset.shown);
    // The list keeps the tallest height it has had, so a filter with fewer rows doesn't make the page
    // below it jump up.
    const hold = () => {
      list.style.minHeight = `${Math.max(parseFloat(list.style.minHeight) || 0, list.offsetHeight)}px`;
    };
    const apply = () => {
      const on = new Set(boxes.filter((b) => b.checked).map((b) => b.dataset.fitRarity));
      all.checked = on.size === boxes.length;
      all.indeterminate = on.size > 0 && on.size < boxes.length;
      let n = 0;
      for (const row of rows) {
        // Featured picks always show, so a rarity filter or the limit never hides them.
        const show = on.has(row.dataset.rarity) && (n < limit || row.dataset.featured !== undefined);
        row.hidden = !show;
        if (show) row.querySelector('[data-fit-rank]')!.textContent = String(++n);
      }
      hold();
    };
    all.addEventListener('change', () => {
      for (const b of boxes) b.checked = all.checked;
      apply();
    });
    for (const b of boxes) b.addEventListener('change', apply);
    // Row heights change with the width, so measure again from scratch.
    let width = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === width) return;
      width = window.innerWidth;
      list.style.minHeight = '';
      hold();
    });
    apply();
  }
</script>

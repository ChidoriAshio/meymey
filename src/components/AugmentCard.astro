---
import { RARITY_LABEL, formatRate, type Augment } from '../lib/data';

interface Props {
  augment: Augment;
  compact?: boolean;
}

const { augment: a, compact = false } = Astro.props;
const ring = { silver: 'ring-silver', gold: 'ring-gold', prismatic: 'ring-prismatic' }[a.rarity];
const text = { silver: 'text-silver', gold: 'text-gold', prismatic: 'text-prismatic' }[a.rarity];
---

<a
  href={`/augments/${a.slug}/`}
  class="flex items-start gap-3 rounded-lg border border-line bg-panel p-3 hover:border-accent transition-colors"
>
  {
    a.icon ? (
      <img src={a.icon} alt="" width="48" height="48" loading="lazy" class={`size-12 rounded-md ring-2 ${ring} bg-panel-2 shrink-0`} />
    ) : (
      <div class={`size-12 rounded-md ring-2 ${ring} bg-panel-2 shrink-0`} />
    )
  }
  <div class="min-w-0">
    <div class="font-semibold leading-tight">{a.name}</div>
    <div class="text-xs mt-1 flex gap-2">
      <span class={text}>{RARITY_LABEL[a.rarity]}</span>
      <span class="text-ink-2">ピック率 {formatRate(a.pickRate)}</span>
    </div>
    {!compact && <p class="tooltip-text text-sm text-ink-2 mt-2 line-clamp-3" set:html={a.description} />}
  </div>
</a>

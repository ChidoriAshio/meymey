---
import '../styles/global.css';
import { meta } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ランダムミッド: メイヘム（ARAM Mayhem）のチャンピオン、オーグメント、ビルドを日本語で調べられるサイト。' } = Astro.props;
const fullTitle = title ? `${title} | メイメイ` : 'メイメイ — ARAMメイヘム攻略データ';
const path = Astro.url.pathname;
const nav = [
  { href: '/tier-list/', label: 'ティアリスト' },
  { href: '/champions/', label: 'チャンピオン' },
  { href: '/augments/', label: 'オーグメント' },
  { href: '/items/', label: 'アイテム' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line bg-panel/80 backdrop-blur sticky top-0 z-10">
      <div class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-4 sm:gap-6">
        <a href="/" class="font-bold text-accent text-lg shrink-0">メイメイ</a>
        <nav class="flex gap-3 sm:gap-4 text-sm overflow-x-auto">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'whitespace-nowrap py-1 hover:text-accent',
                  path.startsWith(n.href) ? 'text-accent' : 'text-ink-2',
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <span class="ml-auto hidden sm:block text-xs text-ink-2">パッチ {meta.patch}</span>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-4 py-6 flex-1">
      <slot />
    </main>

    <footer class="border-t border-line text-xs text-ink-2">
      <div class="mx-auto max-w-6xl px-4 py-6 space-y-2">
        <p>
          ピック率の<a class="underline hover:text-accent" href={meta.stats.source}>データ出典: arammayhem.com</a>（<a
            class="underline hover:text-accent"
            href={meta.stats.licenseUrl}>{meta.stats.license}</a
          >、パッチ {meta.stats.patch}、集計日 {meta.stats.statsDate}）。限られたサンプルの集計で、全サーバーの値ではありません。
        </p>
        <p>ゲームデータ: Data Dragon {meta.gameVersion}、CommunityDragon。</p>
        <p>
          メイメイは Riot Games の承認を受けたものではなく、Riot Games および League of Legends の制作・運営に公式に関わる人物の見解や意見を反映するものではありません。League of Legends および Riot Games は Riot Games, Inc. の商標または登録商標です。
        </p>
      </div>
    </footer>
  </body>
</html>

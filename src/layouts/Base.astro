---
import '../styles/global.css';
import { cnStats, meta } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ランダムミッド: メイヘム（ARAM Mayhem）のチャンピオン、オーグメント、ビルドを日本語で調べられるサイト。' } = Astro.props;
const fullTitle = title ? `${title} | メイヘム攻略データ` : 'ランダムミッド: メイヘム 攻略データ';
const path = Astro.url.pathname;
const nav = [
  { href: '/tier-list/', label: 'ティア' },
  { href: '/augments/', label: 'オーグメント' },
  { href: '/items/', label: 'アイテム' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Shippori+Mincho:wght@600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="site-header sticky top-0 z-10 backdrop-blur">
      <div class="mx-auto max-w-6xl px-4 py-2 sm:py-0 sm:h-14 flex flex-wrap sm:flex-nowrap items-center gap-x-4 gap-y-1 sm:gap-6">
        <a href="/" class="logo shrink-0">ランダムミッド: メイヘム 攻略データ</a>
        <nav class="flex gap-4 text-sm overflow-x-auto w-full sm:w-auto">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'whitespace-nowrap py-1 hover:text-accent',
                  path.startsWith(n.href) ? 'text-accent' : 'text-ink-2',
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <span class="ml-auto hidden sm:block text-xs text-ink-2">パッチ {meta.patch}</span>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-4 py-6 flex-1">
      <slot />
    </main>

    <footer class="site-footer text-xs text-ink-2">
      <div class="mx-auto max-w-6xl px-4 py-6 space-y-2">
        <p>
          ピック率と、おすすめオーグメントの叩き台（コンボ）の<a class="underline hover:text-accent" href={meta.stats.source}>データ出典: arammayhem.com</a>（<a
            class="underline hover:text-accent"
            href={meta.stats.licenseUrl}>{meta.stats.license}</a
          >、パッチ {meta.stats.patch}、集計日 {meta.stats.statsDate}）。限られたサンプルの集計で、全サーバーの値ではありません。
        </p>
        <p>
          チャンピオン別のオーグメント採用率の出典: <a class="underline hover:text-accent" href="https://github.com/czgreat/aramhex-data"
            >海克斯大乱斗统计数据（github.com/czgreat/aramhex-data）</a
          >、<a class="underline hover:text-accent" href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a
          >。中国サーバーの集計（パッチ {cnStats.patch}）から試合数だけを使い、選ばれた割合に加工しています。
        </p>
        <p>ゲームデータ: Data Dragon {meta.gameVersion}、CommunityDragon。</p>
        <p>
          当サイトは Riot Games の承認を受けたものではなく、Riot Games および League of Legends の制作・運営に公式に関わる人物の見解や意見を反映するものではありません。League of Legends および Riot Games は Riot Games, Inc. の商標または登録商標です。
        </p>
      </div>
    </footer>
    <script>
      // Tooltips open on focus (tap on phones). Phones don't drop focus when tapping elsewhere,
      // so close them on a tap outside, and on a second tap of the same icon.
      const tipSelector = '.tip, .aug-tip';
      let wasOpen: HTMLElement | null = null;
      document.addEventListener(
        'pointerdown',
        (e) => {
          const open = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>(tipSelector) ?? null;
          const target = e.target as Element;
          // Taps inside an open tooltip (its link, its text) leave it open.
          wasOpen = open && !target.closest('[role="tooltip"]') ? open : null;
          if (open && !open.contains(target)) open.blur();
        },
        true,
      );
      // The tap itself focuses the icon again, so a second tap on it closes after the click.
      document.addEventListener('click', (e) => {
        const tip = (e.target as Element).closest<HTMLElement>(tipSelector);
        if (tip && tip === wasOpen) setTimeout(() => tip.blur());
        wasOpen = null;
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    background: linear-gradient(180deg, rgb(1 10 19 / 0.95), rgb(10 20 40 / 0.85));
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, var(--color-accent-2) 20%, var(--color-accent) 50%, var(--color-accent-2) 80%, transparent) 1;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    background: linear-gradient(180deg, #f0e6d2, #c8aa6e 60%, #785a28);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .site-footer {
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, var(--color-accent-2), transparent) 1;
  }
</style>

---
import Base from '../layouts/Base.astro';
import ChampionTile from '../components/ChampionTile.astro';
import { champions, getBuilds, TIERS } from '../lib/data';

const builds = await getBuilds();
const byTier = TIERS.map((tier) => ({
  tier,
  list: champions.filter((c) => builds.get(c.slug)?.tier === tier),
}));
const hasTiers = byTier.some((t) => t.list.length);
const popular = [...champions].filter((c) => c.pickRate != null).sort((a, b) => b.pickRate! - a.pickRate!);
const tierColor: Record<string, string> = {
  S: 'bg-[#ff6b6b]',
  A: 'bg-[#ffa94d]',
  B: 'bg-[#ffd43b]',
  C: 'bg-[#69db7c]',
  D: 'bg-[#74c0fc]',
};
---

<Base title="ティアリスト">
  <h1 class="text-2xl font-bold mb-2">チャンピオン ティアリスト</h1>

  {
    hasTiers ? (
      <div class="space-y-2 mb-10">
        {byTier.map(({ tier, list }) => (
          <div class="flex rounded-lg border border-line overflow-hidden">
            <div class={`${tierColor[tier]} text-bg font-bold text-2xl w-14 shrink-0 flex items-center justify-center`}>{tier}</div>
            <div class="flex flex-wrap gap-3 p-3 bg-panel flex-1 min-h-20">
              {list.map((c) => <ChampionTile champion={c} showRate={false} />)}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-ink-2 mb-10">
        ティアはまだ登録されていません。<code class="text-accent">src/data/builds.yaml</code> にチャンピオンごとの tier を書くとここに表示されます。
      </p>
    )
  }

  <h2 class="text-lg font-bold mb-1">ピック率ランキング</h2>
  <p class="text-sm text-ink-2 mb-3">よく選ばれている順です。強さ（勝率）の順ではありません。</p>
  <ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6">
    {
      popular.map((c, i) => (
        <li class="flex items-center gap-3 py-1.5 border-b border-line">
          <span class="w-8 text-right text-ink-2 text-sm">{i + 1}</span>
          <img src={c.icon} alt="" width="32" height="32" loading="lazy" class="size-8 rounded" />
          <a href={`/champions/${c.slug}/`} class="flex-1 hover:text-accent">{c.name}</a>
          <span class="text-sm tabular-nums">{c.pickRate!.toFixed(2)}%</span>
        </li>
      ))
    }
  </ol>
</Base>

---
import Base from '../layouts/Base.astro';
import ListFilter from '../components/ListFilter.astro';
import ChampionTile from '../components/ChampionTile.astro';
import { champions, getBuilds, meta, ROLE_LABEL, tierOf } from '../lib/data';

const builds = await getBuilds();
const roles = Object.entries(ROLE_LABEL).map(([value, label]) => ({ value, label }));
const topChampions = [...champions]
  .filter((c) => c.pickRate != null)
  .sort((a, b) => b.pickRate! - a.pickRate!)
  .slice(0, 12);
---

<Base title="">
  <section class="home-hero relative -mx-4 sm:mx-0 mb-8 overflow-hidden sm:rounded-lg sm:border border-line">
    <img
      src={`https://ddragon.leagueoflegends.com/cdn/img/champion/splash/${topChampions[0].id}_0.jpg`}
      alt=""
      class="absolute inset-0 size-full object-cover object-[center_25%] opacity-40"
      fetchpriority="high"
    />
    <div class="relative px-4 py-10 sm:px-8 sm:py-14">
      <p class="text-xs tracking-[0.3em] text-hextech">ARAM: MAYHEM</p>
      <h1 class="text-2xl sm:text-4xl font-bold mt-1">ランダムミッド: メイヘム 攻略データ</h1>
      <p class="text-sm text-ink-2 mt-2 max-w-xl">
        使うチャンピオンを選ぶと、おすすめのオーグメントとアイテムが見られます（パッチ {meta.patch}）。
      </p>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-lg font-bold mb-3">よく選ばれるチャンピオン</h2>
    <div class="grid grid-cols-4 sm:grid-cols-6 lg:grid-cols-12 gap-3">
      {topChampions.map((c) => <ChampionTile champion={c} tier={tierOf(c, builds)?.tier} />)}
    </div>
  </section>

  <h2 class="text-lg font-bold mb-3">すべてのチャンピオン</h2>
  <ListFilter
    placeholder="チャンピオン名で検索（例: あーり、Ahri）"
    tags={roles}
    sorts={[
      { value: 'name', label: '名前順' },
      { value: 'pick', label: 'ピック率順' },
    ]}
  />
  <div data-filter-list class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 gap-4">
    {
      champions.map((c) => (
        <div data-search={`${c.name} ${c.id} ${c.title}`} data-tags={c.tags.join(' ')} data-sort-pick={c.pickRate ?? -1}>
          <ChampionTile champion={c} />
        </div>
      ))
    }
  </div>
</Base>

<style>
  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(1 10 19 / 0.95) 0%, rgb(1 10 19 / 0.6) 60%, rgb(1 10 19 / 0.2)),
      linear-gradient(180deg, transparent 60%, var(--color-bg));
    pointer-events: none;
  }
  .home-hero > div {
    z-index: 1;
  }
</style>

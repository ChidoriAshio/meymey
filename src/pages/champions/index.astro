---
import Base from '../../layouts/Base.astro';
import ListFilter from '../../components/ListFilter.astro';
import ChampionTile from '../../components/ChampionTile.astro';
import { champions, ROLE_LABEL } from '../../lib/data';

const roles = Object.entries(ROLE_LABEL).map(([value, label]) => ({ value, label }));
---

<Base title="チャンピオン一覧">
  <h1 class="text-2xl font-bold mb-4">チャンピオン一覧</h1>
  <ListFilter placeholder="名前で検索（例: あーり、Ahri）" tags={roles} />
  <div data-filter-list class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 gap-4">
    {
      champions.map((c) => (
        <div data-search={`${c.name} ${c.id} ${c.title}`} data-tags={c.tags.join(' ')}>
          <ChampionTile champion={c} />
        </div>
      ))
    }
  </div>
</Base>

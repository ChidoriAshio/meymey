---
import Base from '../../layouts/Base.astro';
import AugmentCard from '../../components/AugmentCard.astro';
import Change from '../../components/Change.astro';
import { champions, getBuilds, meta, ROLE_LABEL, formatRate, type Champion } from '../../lib/data';

export function getStaticPaths() {
  return champions.map((champion) => ({ params: { slug: champion.slug }, props: { champion } }));
}

const { champion: c } = Astro.props as { champion: Champion };
const build = (await getBuilds()).get(c.slug);
---

<Base title={`${c.name}のビルドとオーグメント`} description={`ランダムミッド: メイヘムの${c.name}のおすすめオーグメント、アイテム、ピック率。`}>
  <a href="/champions/" class="text-sm text-ink-2 hover:text-accent">← チャンピオン一覧</a>

  <header class="flex items-center gap-4 mt-3 mb-6">
    <img src={c.icon} alt="" width="80" height="80" class="size-20 rounded-xl border border-line" />
    <div>
      <p class="text-sm text-ink-2">{c.title}</p>
      <h1 class="text-2xl font-bold">{c.name}</h1>
      <p class="text-xs text-ink-2 mt-1">{c.tags.map((t) => ROLE_LABEL[t] ?? t).join(' / ')}</p>
    </div>
    {
      build?.tier && (
        <div class="ml-auto text-center">
          <div class="text-xs text-ink-2">ティア</div>
          <div class="text-3xl font-bold text-accent">{build.tier}</div>
        </div>
      )
    }
  </header>

  <section class="grid sm:grid-cols-2 gap-3 mb-8">
    <div class="rounded-lg border border-line bg-panel p-4">
      <div class="text-xs text-ink-2">ピック率（パッチ {meta.stats.patch}）</div>
      <div class="text-2xl font-bold tabular-nums mt-1">{formatRate(c.pickRate)} <Change value={c.pickRateChange} /></div>
    </div>
    <div class="rounded-lg border border-line bg-panel p-4">
      <div class="text-xs text-ink-2">ピック率の順位</div>
      <div class="text-2xl font-bold tabular-nums mt-1">{c.pickRateRank ? `${c.pickRateRank}位` : '—'} <span class="text-sm text-ink-2 font-normal">/ {champions.length}体</span></div>
    </div>
  </section>

  {
    build ? (
      <>
        {build.note && <p class="mb-6 rounded-lg border border-line bg-panel-2 p-4">{build.note}</p>}
        {build.augments.length > 0 && (
          <section class="mb-8">
            <h2 class="text-lg font-bold mb-3">おすすめオーグメント</h2>
            <div class="grid sm:grid-cols-2 gap-3">
              {build.augments.map((a) => <AugmentCard augment={a} />)}
            </div>
          </section>
        )}
        {build.items.length > 0 && (
          <section class="mb-8">
            <h2 class="text-lg font-bold mb-3">おすすめアイテム</h2>
            <ol class="flex flex-wrap gap-4">
              {build.items.map((it, i) => (
                <li class="flex flex-col items-center w-20 text-center">
                  <img src={it.icon} alt="" width="48" height="48" loading="lazy" class="size-12 rounded border border-line" />
                  <span class="text-xs mt-1 leading-tight">{i + 1}. {it.name}</span>
                </li>
              ))}
            </ol>
          </section>
        )}
      </>
    ) : (
      <p class="text-ink-2 mb-8">
        おすすめのオーグメントとアイテムはまだ登録されていません（<code class="text-accent">src/data/builds.yaml</code> の <code>{c.slug}</code>）。
      </p>
    )
  }
</Base>
